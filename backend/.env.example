DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/sga_abacos
SECRET_KEY=development_secret_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120
RESET_TOKEN_EXPIRE_MINUTES=30
ADMIN_SEED_EMAIL=admin@abaco.org.br
ADMIN_SEED_PASSWORD=troque-esta-senha
# --- Seed de dados de teste ---------------------------------------------------
# Liga o seed automatico no boot. Em producao deixe false e rode sob demanda:
#   python -m app.db.seed
SEED_ON_STARTUP=true
# Senhas dos usuarios de teste. Sem valor, esses usuarios (e dependentes) sao pulados.
SEED_ADMIN_PASSWORD=admin123
SEED_PROFESSOR_PASSWORD=prof12345
# --- E-mail (Brevo/SMTP) ------------------------------------------------------
# Prioridade: Brevo > SMTP > console (fallback; nao envia).
# O Brevo e usado se BREVO_API_KEY estiver preenchida. O SMTP so e usado se
# BREVO_API_KEY estiver vazia E SMTP_USER estiver preenchido; sem isso os
# e-mails vao apenas para o log (console) e nao sao enviados.
# Restricoes (detalhes em .env.example na raiz do repositorio):
# - Gmail: senha de app de 16 caracteres (sem espacos), limite de ~500
#   destinatarios/dia, portas 587 (STARTTLS) ou 465 (SSL).
# - Brevo: envia por HTTPS (porta 443), funciona em redes que bloqueiam SMTP.
# Para habilitar recuperacao de senha e primeiro acesso pelo Gmail:
# 1. Acesse https://myaccount.google.com/apppasswords
# 2. Ative a verificacao em duas etapas se necessario
# 3. Gere uma "Senha de app" (selecione "Outro" e nomeie "ABACO")
# 4. Cole a senha de 16 caracteres abaixo em SMTP_PASSWORD
# SMTP_USER deve ser o endereco Gmail completo, nao a senha.
# Padrao no backend quando SMTP_HOST nao e definido: "localhost"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-de-16-caracteres
# Use o MESMO endereco de SMTP_USER: o Gmail rejeita From de outro dominio.
# Com Brevo, use um remetente verificado na conta.
SMTP_FROM=seu-email@gmail.com
SMTP_TIMEOUT_SECONDS=15
BREVO_API_KEY=
EMAIL_SENDER_NAME=SGA ABACO
FRONTEND_URL=http://localhost:3000