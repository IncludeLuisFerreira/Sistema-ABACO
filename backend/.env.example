DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/sga_abacos
SECRET_KEY=development_secret_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120
RESET_TOKEN_EXPIRE_MINUTES=15
ADMIN_SEED_EMAIL=admin@abaco.org.br
ADMIN_SEED_PASSWORD=troque-esta-senha
# --- E-mail (SMTP via Gmail) --------------------------------------------------
# Para habilitar recuperacao de senha, configure uma conta Gmail:
# 1. Acesse https://myaccount.google.com/apppasswords
# 2. Ative a verificacao em duas etapas se necessario
# 3. Gere uma "Senha de app" (selecione "Outro" e nomeie "ABACO")
# 4. Cole a senha de 16 caracteres abaixo em SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-de-16-caracteres
SMTP_FROM=noreply@abaco.org.br
FRONTEND_URL=http://localhost:3000