# ============================================================
# SGA ABACO - Environment Configuration
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# --- Database ---
POSTGRES_DB=sga_abacos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/sga_abacos

# --- JWT / Security ---
JWT_SECRET=development_secret_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120
RESET_TOKEN_EXPIRE_MINUTES=15

# --- Admin Seed (criado automaticamente na primeira execução) ---
ADMIN_SEED_EMAIL=admin@abaco.org.br
ADMIN_SEED_PASSWORD=admin123

# --- SMTP (deixe vazio para fallback no console) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@abaco.org.br

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute

# --- CORS (separados por vírgula) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200

# --- Backend ---
PORT=8000
