# ============================================================
# SGA ABACO - Environment Configuration
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# --- Database ---
POSTGRES_DB=sga_abacos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/sga_abacos

# --- JWT / Security ---
JWT_SECRET=development_secret_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120
RESET_TOKEN_EXPIRE_MINUTES=30
FIRST_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin Seed (criado automaticamente na primeira execução) ---
ADMIN_SEED_EMAIL=admin@abaco.org.br
ADMIN_SEED_PASSWORD=admin123

# --- E-mail transacional ---
# Escolha UM provedor. Ordem de prioridade: Brevo > SMTP > console (dev).
#
# IMPORTANTE: se BREVO_API_KEY estiver preenchida, o Brevo tem prioridade e o
# SMTP nunca e usado. Para usar o Gmail, deixe BREVO_API_KEY vazia/comentada.
#
# Gmail (SMTP):
#   1. Ative a verificacao em duas etapas na conta Google
#   2. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#   3. Preencha SMTP_USER e SMTP_PASSWORD com essa senha (16 caracteres; pode
#      colar com ou sem espacos)
#   4. SMTP_FROM deve ser o MESMO endereco de SMTP_USER
#   Limite do Gmail: ~500 destinatarios/dia.
#   Portas: 587 (STARTTLS) ou 465 (SSL). Algumas redes bloqueiam 587/25; nesse
#   caso use 465 ou volte para o Brevo, que envia por HTTPS (porta 443).
#
# Brevo:
#   BREVO_API_KEY + SMTP_FROM de um remetente/dominio verificado na conta.
#   A API usa HTTPS, entao funciona em redes que bloqueiam portas SMTP.

# Remetente do e-mail.
# No Gmail, use o MESMO endereco de SMTP_USER (o Gmail rejeita From de outro dominio).
# Na Brevo, o remetente/dominio precisa estar verificado na conta.
SMTP_FROM=seu-email@gmail.com
# Nome exibido do remetente
EMAIL_SENDER_NAME=SGA ABACO

# Brevo (chave da API; se preenchida, tem prioridade sobre o SMTP)
BREVO_API_KEY=

# SMTP (usado quando BREVO_API_KEY estiver vazio)
# Padrao no backend quando SMTP_HOST nao e definido: "localhost"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Timeout (segundos) das conexoes SMTP
SMTP_TIMEOUT_SECONDS=15

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute

# --- CORS (separados por vírgula) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200

# --- Backend ---
PORT=8000
