@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam usecaseFontSize 12
skinparam actorFontSize 12
left to right direction
skinparam packageStyle rectangle

' ============================================================
' ATORES
' ============================================================

actor ": Diretor(a)" as Diretor <<cargo=1>>
actor ": Professor(a)" as Professor <<cargo=2>>
actor ": Admin" as Admin <<cargo=3>>
actor ": Visitante" as Visitante <<nao autenticado>>

' ============================================================
' MODULO DE AUTENTICACAO
' ============================================================

package "Autenticacao" {
  usecase (UC01\nRealizar Login) as UC01
  usecase (UC02\nRecuperar Senha) as UC02
  usecase (UC03\nRedefinir Senha) as UC03
}

UC02 ..> UC03 : <<include>>
Visitante --> UC01
Visitante --> UC02
Visitante --> UC03

' ============================================================
' MODULO ACADEMICO
' ============================================================

package "Modulo Academico" {
  usecase (UC04\nCadastrar Aluno) as UC04
  usecase (UC05\nEditar Aluno) as UC05
  usecase (UC06\nExcluir Aluno) as UC06
  usecase (UC07\nVisualizar Aluno) as UC07
  usecase (UC08\nCadastrar Curso) as UC08
  usecase (UC09\nEditar Curso) as UC09
  usecase (UC10\nExcluir Curso) as UC10
  usecase (UC11\nVisualizar Curso) as UC11
  usecase (UC12\nCriar Turma) as UC12
  usecase (UC13\nEditar Turma) as UC13
  usecase (UC14\nExcluir Turma) as UC14
  usecase (UC15\nVisualizar Turma) as UC15
  usecase (UC16\nListar Minhas Turmas) as UC16
  usecase (UC17\nRealizar Matricula) as UC17
  usecase (UC18\nEditar Matricula) as UC18
  usecase (UC19\nExcluir Matricula) as UC19
  usecase (UC20\nVisualizar Matricula) as UC20
  usecase (UC21\nListar Minhas Matriculas) as UC21
  usecase (UC22\nLancar Notas em Lote) as UC22
  usecase (UC23\nVisualizar Notas) as UC23
  usecase (UC24\nCalcular Media por Prova) as UC24
  usecase (UC25\nRegistrar Presencas) as UC25
  usecase (UC26\nVisualizar Presencas) as UC26
  usecase (UC27\nGerar Historico Escolar) as UC27
  usecase (UC28\nExportar Historico PDF) as UC28
}

UC27 ..> UC23 : <<include>>
UC27 ..> UC26 : <<include>>
UC27 ..> UC28 : <<extend>>

' Conexoes Aluno
