    %% ---- ENTITY RELATIONSHIPS ----
    Aluno "1" --> "*" Matricula
    Curso "1" --> "*" Turma
    Turma "1" --> "*" Matricula
    Turma "*" --> "0..1" Usuario : professor
    Turma "1" --> "*" Pedido
    Matricula "1" --> "*" Nota
    Matricula "1" --> "*" Presenca
    Usuario "1" --> "*" Pedido : solicitante
    Pedido "1" --> "*" ItemPedido
    ItemPedido "*" --> "0..1" Estoque
    Estoque "1" --> "*" MovimentacaoEstoque


